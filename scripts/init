#!/bin/busybox sh
export PATH=/bin:/sbin:/usr/bin:/usr/sbin:/usr/local/bin:/usr/local/sbin

# Install busybox symlinks
/bin/busybox --install -s /bin 2>/dev/null || true

# Mount essential filesystems
mount -t proc none /proc
mount -t sysfs none /sys
mount -t devtmpfs none /dev
mkdir -p /dev/pts /dev/shm
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /dev/shm

# Disable display & console blanking (keep AMOLED screen awake)
echo 0 > /sys/class/graphics/fb0/blank 2>/dev/null || true
echo 0 > /sys/module/kernel/parameters/consoleblank 2>/dev/null || true
echo -ne "\033[9;0]\033[14;0]" > /dev/tty0 2>/dev/null || true
(
  while true; do
    echo 0 > /sys/class/graphics/fb0/blank 2>/dev/null || true
    echo -ne "\033[9;0]\033[14;0]" > /dev/tty0 2>/dev/null || true
    sleep 30
  done
) &

echo ""
echo "=========================================="
echo "   Alpine Linux ARMv7 (Linux 6.16)        "
echo "   Motorola Moto X 2014 (victara)         "
echo "=========================================="
echo ""

# Setup USB RNDIS & CDC ACM gadget via ConfigFS
mount -t configfs none /sys/kernel/config 2>/dev/null || true
G=/sys/kernel/config/usb_gadget/victara
mkdir -p "$G/strings/0x409" "$G/functions/rndis.usb0" "$G/functions/acm.usb0" "$G/configs/c.1/strings/0x409" 2>/dev/null || true
echo 0x22b8 > "$G/idVendor" 2>/dev/null || true
echo 0x2e82 > "$G/idProduct" 2>/dev/null || true
echo motorola > "$G/strings/0x409/manufacturer" 2>/dev/null || true
echo victara > "$G/strings/0x409/product" 2>/dev/null || true
echo 0014302157 > "$G/strings/0x409/serialnumber" 2>/dev/null || true
echo "RNDIS + Serial" > "$G/configs/c.1/strings/0x409/configuration" 2>/dev/null || true
echo 500 > "$G/configs/c.1/MaxPower" 2>/dev/null || true

# Set static valid MAC addresses on RNDIS endpoints
echo "02:00:89:74:00:01" > "$G/functions/rndis.usb0/dev_addr" 2>/dev/null || true
echo "02:00:89:74:00:02" > "$G/functions/rndis.usb0/host_addr" 2>/dev/null || true

ln -sfn "$G/functions/rndis.usb0" "$G/configs/c.1/" 2>/dev/null || true
ln -sfn "$G/functions/acm.usb0" "$G/configs/c.1/" 2>/dev/null || true

echo "Waiting for USB device controller (UDC)..."
UDC=""
for i in $(seq 1 20); do
  UDC=$(ls -1 /sys/class/udc 2>/dev/null | head -n 1 || true)
  if [ -n "$UDC" ]; then
    echo "UDC detected: $UDC"
    echo "$UDC" > "$G/UDC" 2>/dev/null || true
    break
  fi
  sleep 1
done

if [ -n "$UDC" ]; then
  # Find USB network interface name (usb0, rndis0 or eth0)
  USB_IF=""
  for i in $(seq 1 10); do
    for name in usb0 rndis0 eth0; do
      if [ -d "/sys/class/net/$name" ]; then
        USB_IF="$name"
        break 2
      fi
    done
    sleep 1
  done

  if [ -n "$USB_IF" ]; then
    ifconfig "$USB_IF" 172.16.42.1 netmask 255.255.255.0 up 2>/dev/null || true
    ifconfig "${USB_IF}:1" 192.168.42.2 netmask 255.255.255.0 up 2>/dev/null || true
    echo "USB network ($USB_IF) active on 172.16.42.1 / 192.168.42.2"
  else
    echo "Warning: USB network interface not found in /sys/class/net/"
  fi

  # Start Dropbear SSH (port 22 and 2222, root login without password)
  /usr/sbin/dropbear -R -B -E -p 22 -p 2222 2>/dev/null || /usr/sbin/dropbear -B -p 22 2>/dev/null || true
  echo "SSH server active on port 22 (ssh root@172.16.42.1)"

  # Start Telnetd on port 23
  telnetd -l /bin/sh 2>/dev/null || true
  echo "Telnet server active on port 23 (telnet 172.16.42.1)"

  # Persistent USB serial console
  while true; do
    if [ -e /dev/ttyGS0 ]; then
      /bin/sh </dev/ttyGS0 >/dev/ttyGS0 2>&1
    fi
    sleep 1
  done &
  echo "USB serial console active on /dev/ttyGS0"
else
  echo "UDC not found after 20s"
fi

# Bring up wlan0 in background once hardware initializes
(
  for i in $(seq 1 30); do
    if [ -d /sys/class/net/wlan0 ]; then
      MAC=$(cat /sys/class/net/wlan0/address 2>/dev/null || true)
      if [ -z "$MAC" ] || [ "$MAC" = "00:00:00:00:00:00" ]; then
        NEW_MAC="e0:75:7d:$(printf '%02x:%02x:%02x' $((RANDOM%256)) $((RANDOM%256)) $((RANDOM%256)))"
        ip link set dev wlan0 down 2>/dev/null || true
        ip link set dev wlan0 address "$NEW_MAC" 2>/dev/null || true
      fi
      ip link set wlan0 up 2>/dev/null || true
      echo "WiFi wlan0 detected and ready!"
      if [ -s /etc/wpa_supplicant/wpa_supplicant.conf ]; then
        wpa_supplicant -B -i wlan0 -c /etc/wpa_supplicant/wpa_supplicant.conf 2>/dev/null || true
        udhcpc -i wlan0 -b 2>/dev/null || true
      fi
      break
    fi
    sleep 1
  done
) &

echo ""
echo "=== System Ready ==="
echo "SSH:       ssh -o StrictHostKeyChecking=no root@172.16.42.1"
echo "Telnet:    telnet 172.16.42.1"
echo "Serial:    picocom -b 115200 /dev/ttyACM0"
echo "WiFi:      wifi-connect <SSID> [PASSWORD]"
echo "Scan:      wifi-scan"
echo "Battery:   battery"
echo "Packages:  apk update && apk add <pkg>"
echo "Install:   install-to-emmc"
echo ""

while true; do
  /bin/sh
  sleep 1
done
