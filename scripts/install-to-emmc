#!/bin/sh
set -e
TARGET="/dev/mmcblk0p28"
echo "=== Alpine Linux eMMC Installer ($TARGET) ==="
if [ ! -b "$TARGET" ]; then
  echo "Error: $TARGET not found!"
  exit 1
fi
echo "Formatting $TARGET as ext4..."
mkfs.ext4 -F -L "userdata" "$TARGET"
mkdir -p /mnt/target
mount "$TARGET" /mnt/target
echo "Copying root filesystem to eMMC..."
cp -a /bin /sbin /usr /lib /etc /root /var /mnt/target/
mkdir -p /mnt/target/proc /mnt/target/sys /mnt/target/dev /mnt/target/tmp /mnt/target/mnt /mnt/target/run
chmod 1777 /mnt/target/tmp
printf '%s / ext4 defaults,noatime 0 1\n' "$TARGET" > /mnt/target/etc/fstab
umount /mnt/target
echo "=== Installation completed successfully! ==="
