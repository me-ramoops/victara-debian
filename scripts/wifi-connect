#!/bin/sh
SSID="$1"
PASS="$2"

if [ -z "$SSID" ]; then
  echo "Usage: wifi-connect <SSID> [PASSWORD]"
  echo "Examples:"
  echo "  Secured:  wifi-connect 'MySSID' 'MyPassword'"
  echo "  Open:     wifi-connect 'OpenNetwork'"
  exit 1
fi

echo "[*] Checking WiFi hardware and MAC address..."
FACTORY_MAC="e0:75:7d:c8:62:e5"
MAC=$(cat /sys/class/net/wlan0/address 2>/dev/null || true)
if [ -z "$MAC" ] || [ "$MAC" = "00:00:00:00:00:00" ] || [ "$MAC" != "$FACTORY_MAC" ]; then
  echo "[*] Ensuring interface MAC matches firmware NV: $FACTORY_MAC"
  ip link set dev wlan0 down 2>/dev/null || true
  ip link set dev wlan0 address "$FACTORY_MAC" 2>/dev/null || true
fi

ip link set wlan0 up 2>/dev/null || true
iw dev wlan0 set power_save off 2>/dev/null || true

mkdir -p /etc/wpa_supplicant /var/run/wpa_supplicant /var/log

if [ -z "$PASS" ] || [ "$PASS" = "none" ] || [ "$PASS" = "NONE" ]; then
  echo "[*] Configuring open network: $SSID"
  cat > /etc/wpa_supplicant/wpa_supplicant.conf <<CONF
ctrl_interface=/var/run/wpa_supplicant
update_config=1

network={
    ssid="$SSID"
    key_mgmt=NONE
    scan_ssid=1
}
CONF
else
  echo "[*] Configuring secured network: $SSID"
  cat > /etc/wpa_supplicant/wpa_supplicant.conf <<CONF
ctrl_interface=/var/run/wpa_supplicant
update_config=1

network={
    ssid="$SSID"
    psk="$PASS"
    scan_ssid=1
    ieee80211w=1
}
CONF
fi

iw reg set BR 2>/dev/null || true

chmod 600 /etc/wpa_supplicant/wpa_supplicant.conf

echo "[*] Restarting wpa_supplicant..."
killall -9 wpa_supplicant udhcpc 2>/dev/null || true
rm -rf /var/run/wpa_supplicant/* 2>/dev/null || true
sleep 1

wpa_supplicant -B -i wlan0 -c /etc/wpa_supplicant/wpa_supplicant.conf > /var/log/wpa_supplicant.log 2>&1

echo "[*] Waiting for WiFi association (up to 20s)..."
CONNECTED=0
for i in $(seq 1 20); do
  if wpa_cli -i wlan0 status 2>/dev/null | grep -q "wpa_state=COMPLETED"; then
    CONNECTED=1
    echo "[+] Successfully connected to AP!"
    break
  fi
  sleep 1
done

if [ "$CONNECTED" -eq 0 ]; then
  echo "[-] Failed to associate with AP."
  echo "[-] Current wpa_supplicant status:"
  wpa_cli -i wlan0 status 2>/dev/null || true
  exit 1
fi

echo "[*] Requesting DHCP lease (udhcpc)..."
udhcpc -i wlan0 -n -q -t 5

echo "[*] Synchronizing system clock via NTP..."
(ntpd -q -n -p pool.ntp.org 2>/dev/null || date -s "2026-10-16 12:00:00" 2>/dev/null) &

echo ""
echo "=== Connection Status ==="
ip addr show wlan0 | grep "inet " || echo "[-] Failed to obtain IP address."
