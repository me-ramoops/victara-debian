#!/bin/sh
SSID="$1"
PASS="$2"

if [ -z "$SSID" ]; then
  echo "Uso: wifi-connect <SSID> [SENHA]"
  echo "Exemplos:"
  echo "  Rede com senha:  wifi-connect 'VIVOFIBRA-WIFI6-D688' 'minhasenha'"
  echo "  Rede aberta:     wifi-connect 'RoteadorCelular'"
  exit 1
fi

echo "[*] Verificando hardware e endereco MAC..."
MAC=$(cat /sys/class/net/wlan0/address 2>/dev/null || true)
if [ -z "$MAC" ] || [ "$MAC" = "00:00:00:00:00:00" ]; then
  NEW_MAC="e0:75:7d:$(printf '%02x:%02x:%02x' $((RANDOM%256)) $((RANDOM%256)) $((RANDOM%256)))"
  echo "[*] Configurando MAC da interface para: $NEW_MAC"
  ip link set dev wlan0 down 2>/dev/null || true
  ip link set dev wlan0 address "$NEW_MAC" 2>/dev/null || true
fi

ip link set wlan0 up 2>/dev/null || true

mkdir -p /etc/wpa_supplicant /var/run/wpa_supplicant /var/log

if [ -z "$PASS" ] || [ "$PASS" = "none" ] || [ "$PASS" = "NONE" ]; then
  echo "[*] Configurando rede aberta (sem senha): $SSID"
  cat > /etc/wpa_supplicant/wpa_supplicant.conf <<CONF
ctrl_interface=/var/run/wpa_supplicant
update_config=1

network={
    ssid="$SSID"
    key_mgmt=NONE
}
CONF
else
  echo "[*] Configurando rede protegida: $SSID (PMF desativado)"
  cat > /etc/wpa_supplicant/wpa_supplicant.conf <<CONF
ctrl_interface=/var/run/wpa_supplicant
update_config=1

network={
    ssid="$SSID"
    psk="$PASS"
    key_mgmt=WPA-PSK
    proto=RSN WPA
    pairwise=CCMP TKIP
    group=CCMP TKIP
    ieee80211w=0
}
CONF
fi

chmod 600 /etc/wpa_supplicant/wpa_supplicant.conf

echo "[*] Reiniciando wpa_supplicant..."
killall -9 wpa_supplicant udhcpc 2>/dev/null || true
rm -rf /var/run/wpa_supplicant/* 2>/dev/null || true
sleep 1

wpa_supplicant -B -i wlan0 -c /etc/wpa_supplicant/wpa_supplicant.conf -f /var/log/wpa_supplicant.log

echo "[*] Aguardando associacao Wi-Fi (ate 20s)..."
CONNECTED=0
for i in $(seq 1 20); do
  if iw dev wlan0 link 2>/dev/null | grep -q "Connected to"; then
    CONNECTED=1
    echo "[+] Conectado com sucesso ao AP!"
    break
  fi
  sleep 1
done

if [ "$CONNECTED" -eq 0 ]; then
  echo "[-] Nao foi possivel associar ao AP."
  echo "[-] Ultimos eventos do wpa_supplicant:"
  tail -n 15 /var/log/wpa_supplicant.log 2>/dev/null || true
  exit 1
fi

echo "[*] Solicitando IP via DHCP (udhcpc)..."
udhcpc -i wlan0 -n -q -t 5

echo ""
echo "=== Status da Conexao ==="
ip addr show wlan0 | grep "inet " || echo "[-] Falha ao obter IP."
